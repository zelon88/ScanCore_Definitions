# Malware distribution URLs from URLhaus.
# Disabled by default only because it needs an account Auth-Key. The matcher can now
# carry a feed this size: a url indicator is extracted from the data once & looked up,
# rather than searched for one indicator at a time, so fifty thousand urls cost the
# same as five hundred. Enable it once you have a key.
# Not redistributed, for the same licensing reason as the CSCB recipe above.
enabled      = no
url          = https://urlhaus-api.abuse.ch/v1/urls/csv_online/{AUTHKEY}/
authenv      = SCANCORE_ABUSECH_KEY
file         = urlhaus-online.csv
format       = csv
comment      = #
skiplines    = 9
kind         = url
label        = column 6
labelprefix  = Malware.URLhaus.
labeldefault = Unknown
nullvalues   = n/a,none,null,unknown,-
value        = column 3
category     = Malware
confidence   = medium
license      = abuse.ch Terms of Use, free under fair use principles
attribution  = Data from abuse.ch URLhaus, https://urlhaus.abuse.ch
redistribute = no
